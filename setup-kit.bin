#!/system/bin/sh
# setup-kit.sh — assemble ONE folder with every shell tool we built.
# Speaks each step aloud so it's clear what's happening.
# Run:  sh /sdcard/Download/setup-kit.sh

KIT=/sdcard/shizuku-kit
BIN=/data/local/tmp/curl
CA=/data/local/tmp/cacert.pem
REPO="https://cdn.jsdelivr.net/gh/landonmoran/solid-guacamole@1b15f48a4e2d159b19ed2b53a4fd7e10b56a7396"

echo "=================================="
echo "Building your shell kit. 6 steps."
echo "=================================="

echo "Step 1 of 6: checking curl..."
if [ ! -x "$BIN" ]; then
    echo "STOPPED: curl not found at $BIN."
    echo "Run the big self-contained installer once first, then try again."
    exit 1
fi
echo "Step 1 done: curl is present."

echo "Step 2 of 6: creating folder $KIT ..."
if ! mkdir -p "$KIT"; then echo "STOPPED: could not create $KIT"; exit 1; fi
echo "Step 2 done: folder ready."

echo "Step 3 of 6: copying curl + certificates into the kit..."
cp "$BIN" "$KIT/curl" && cp "$CA" "$KIT/cacert.pem" || { echo "STOPPED: copy failed"; exit 1; }
echo "Step 3 done: backup copies saved."

echo "Step 4 of 6: looking up download server (this takes a second)..."
JIP=$(ping -c 1 -W 2 cdn.jsdelivr.net 2>/dev/null | head -n1 | sed -n 's/^[^(]*(\([0-9.]*\)).*/\1/p')
if [ -z "$JIP" ]; then echo "STOPPED: could not resolve cdn.jsdelivr.net (network?)"; exit 1; fi
echo "Step 4 done: server is $JIP."

echo "Step 5 of 6: downloading dl.sh and shizuku-lite.sh..."
GET="$BIN --resolve cdn.jsdelivr.net:443:$JIP --cacert $CA -fsSL"
ok=1
for f in dl.sh shizuku-lite.sh; do
    echo "  ...downloading $f"
    if $GET "$REPO/$f" -o "$KIT/$f"; then echo "  ...$f OK"; else echo "  ...$f FAILED"; ok=0; fi
done
[ "$ok" = 1 ] || { echo "STOPPED: a download failed."; exit 1; }
echo "Step 5 done: scripts saved."

echo "Step 6 of 6: writing helper + README..."
cat > "$KIT/run.sh" <<'EOF'
#!/system/bin/sh
K=/sdcard/shizuku-kit
if [ ! -x /data/local/tmp/curl ]; then
    cp "$K/curl" /data/local/tmp/curl && chmod 755 /data/local/tmp/curl && echo "restored curl"
fi
[ -f /data/local/tmp/cacert.pem ] || cp "$K/cacert.pem" /data/local/tmp/cacert.pem
echo "Ready. Commands:"
echo "  install/update apps :  sh $K/shizuku-lite.sh"
echo "  download anything   :  sh $K/dl.sh <url> [outfile]"
EOF
cat > "$KIT/README.txt" <<EOF
Shizuku shell kit — install/update apps from aShell, no browser.

  curl            static downloader (backup of /data/local/tmp/curl)
  cacert.pem      HTTPS certificates
  dl.sh           download any url:        sh $KIT/dl.sh <url> [outfile]
  shizuku-lite.sh install/update the apps: sh $KIT/shizuku-lite.sh
  run.sh          restore curl if wiped:   sh $KIT/run.sh

Everything survives reboots and system updates; only a factory reset wipes it.
EOF
echo "Step 6 done."

echo "=================================="
echo "ALL DONE. Your kit is ready."
echo "Folder: $KIT"
echo "Files in it:"
ls "$KIT"
echo "=================================="
